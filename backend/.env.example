ENVIRONMENT=development
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_FOLDER=qr-menu/menu-items
MAX_IMAGE_UPLOAD_MB=5

FRONTEND_PUBLIC_BASE_URL=http://localhost:5173

# Production does not crash if this is missing; it starts with browser CORS
# disabled so health checks and non-browser clients still work. This is still
# dangerous for a live frontend because browsers cannot call the API until the
# deployed frontend origin is explicitly listed here.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175

# Development-only. In production this is ignored and a warning is logged.
BACKEND_CORS_ORIGIN_REGEX=

# Development can use '*'. In production, leaving this blank on Render uses
# Render's RENDER_EXTERNAL_HOSTNAME automatically. Set exact comma-separated
# custom backend hosts here when using custom API domains; Render's default
# onrender.com host remains trusted automatically.
BACKEND_ALLOWED_HOSTS=*

# Recommended in production before scaling or accepting real traffic. Missing
# Redis falls back to in-memory limits so starter deploys can still boot.
RATE_LIMIT_STORAGE_URL=

# Optional in development; enabled only when ENVIRONMENT=production and SENTRY_DSN is set.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
